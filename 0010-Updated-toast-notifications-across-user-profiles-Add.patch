 /* ===== CART PAGE ===== */
@@ -1258,3 +1266,99 @@ html, body {
 .cs-row-highlight {
     animation: highlightFade 3s ease forwards;
 }
+
+/* ===== WELCOME TOAST ===== */
+@keyframes slideDown {
+    from {
+        opacity: 0;
+        transform: translateX(-50%) translateY(-30px);
+    }
+    to {
+        opacity: 1;
+        transform: translateX(-50%) translateY(0);
+    }
+}
+
+@keyframes slideUp {
+    from {
+        opacity: 1;
+        transform: translateX(-50%) translateY(0);
+    }
+    to {
+        opacity: 0;
+        transform: translateX(-50%) translateY(-30px);
+    }
+}
+
+.cs-welcome-toast {
+    position: fixed;
+    top: 90px;
+    left: 50%;
+    transform: translateX(-50%);
+    background-color: var(--cs-green-pale);
+    border: 2px solid var(--cs-green);
+    color: var(--cs-dark);
+    border-radius: 8px;
+    padding: 1.5rem 2rem;
+    box-shadow: 0 4px 12px rgba(74, 124, 89, 0.2);
+    min-width: 320px;
+    max-width: 600px;
+    text-align: center;
+    z-index: 9999;
+    animation: slideDown 0.6s ease-out forwards;
+}
+
+.cs-welcome-toast h3 {
+    font-size: 1.3rem;
+    font-weight: 800;
+    margin: 0 0 0.5rem 0;
+    letter-spacing: 0.5px;
+    color: var(--cs-green);
+}
+
+.cs-welcome-toast p {
+    font-size: 0.95rem;
+    margin: 0;
+    line-height: 1.6;
+    color: var(--cs-dark);
+}
+
+.cs-welcome-toast a {
+    color: var(--cs-green);
+    font-weight: 700;
+    text-decoration: none;
+    transition: color 0.2s;
+}
+
+.cs-welcome-toast a:hover {
+    color: var(--cs-green-light);
+    text-decoration: underline;
+}
+
+.cs-toast-close {
+    position: absolute;
+    top: 0.75rem;
+    right: 0.75rem;
+    background: var(--cs-green);
+    border: none;
+    color: #fff;
+    font-size: 1.5rem;
+    cursor: pointer;
+    width: 32px;
+    height: 32px;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    border-radius: 50%;
+    transition: background 0.2s;
+    padding: 0;
+    line-height: 1;
+}
+
+.cs-toast-close:hover {
+    background: var(--cs-green-light);
+}
+
+.cs-welcome-toast.hide {
+    animation: slideUp 0.6s ease-out forwards;
+}
