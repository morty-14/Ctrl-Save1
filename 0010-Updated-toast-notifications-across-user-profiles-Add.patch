diff --git a/Controllers/SellerController.cs b/Controllers/SellerController.cs
new file mode 100644
index 0000000..1b9fcc4
--- /dev/null
+++ b/Controllers/SellerController.cs
@@ -0,0 +1,143 @@
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.EntityFrameworkCore;
+using Ctrl_Save.Models;
+
+namespace Ctrl_Save.Controllers
+{
+    [Authorize]
+    public class SellerController : Controller
+    {
+        private readonly Ctrl_SaveContext _context;
+        private readonly IWebHostEnvironment _env;
+
+        public SellerController(Ctrl_SaveContext context, IWebHostEnvironment env)
+        {
+            _context = context;
+            _env = env;
+        }
+
+        public async Task<IActionResult> MyListings()
+        {
+            var sellerId = User.Identity?.Name;
+            var products = await _context.Products
+                .Where(p => p.SellerId == sellerId)
+                .OrderByDescending(p => p.Id)
+                .ToListAsync();
+            return View(products);
+        }
+
+        [HttpPost]
+        public async Task<IActionResult> AddListing(Product product, IFormFile? imageFile)
+        {
+            var sellerId = User.Identity?.Name;
+            var sellerName = User.Claims.FirstOrDefault(c => c.Type == "given_name")?.Value ?? sellerId;
+
+            product.SellerId = sellerId;
+            product.SellerName = sellerName;
+            product.IsAvailable = true;
+            product.Listed = DateTime.Now.ToString("dd MMM yyyy");
+            product.Category = product.Category.ToLower();
+            product.ProductId = product.Category + "-" + product.Name.ToLower()
+                .Replace(" ", "-").Replace("/", "-");
+
+            if (imageFile != null && imageFile.Length > 0)
+            {
+                var folder = Path.Combine(_env.WebRootPath, "images", "products", product.Category);
+                Directory.CreateDirectory(folder);
+                var fileName = Guid.NewGuid().ToString() + Path.GetExtension(imageFile.FileName);
+                using var stream = new FileStream(Path.Combine(folder, fileName), FileMode.Create);
+                await imageFile.CopyToAsync(stream);
+                product.Image = fileName;
+            }
+            else
+            {
+                product.Image = "placeholder.jpg";
+            }
+
+            _context.Products.Add(product);
+            await _context.SaveChangesAsync();
+            return Json(new { success = true, id = product.Id });
+        }
+
+        [HttpPost]
+        public async Task<IActionResult> EditListing(int id, string name, string price, string condition, string includes, IFormFile? imageFile)
+        {
+            var sellerId = User.Identity?.Name;
+            var product = await _context.Products.FirstOrDefaultAsync(p => p.Id == id && p.SellerId == sellerId);
+            if (product == null) return Json(new { success = false });
+
+            product.Name = name;
+            product.Price = "N$" + price.Replace("N$", "").Trim();
+            product.Condition = condition;
+            product.Includes = includes;
+
+            if (imageFile != null && imageFile.Length > 0)
+            {
+                var folder = Path.Combine(_env.WebRootPath, "images", "products", product.Category);
+                Directory.CreateDirectory(folder);
+                var fileName = Guid.NewGuid().ToString() + Path.GetExtension(imageFile.FileName);
+                using var stream = new FileStream(Path.Combine(folder, fileName), FileMode.Create);
+                await imageFile.CopyToAsync(stream);
+                product.Image = fileName;
+            }
+
+            await _context.SaveChangesAsync();
+            return Json(new { success = true });
+        }
+
+        [HttpPost]
+        public async Task<IActionResult> DeleteListing(int id)
+        {
+            var sellerId = User.Identity?.Name;
+            var product = await _context.Products.FirstOrDefaultAsync(p => p.Id == id && p.SellerId == sellerId);
+            if (product == null) return Json(new { success = false });
+            _context.Products.Remove(product);
+            await _context.SaveChangesAsync();
+            return Json(new { success = true });
+        }
+
+        [HttpGet]
+        public async Task<IActionResult> GetListing(int id)
+        {
+            var sellerId = User.Identity?.Name;
+            var product = await _context.Products.FirstOrDefaultAsync(p => p.Id == id && p.SellerId == sellerId);
+            if (product == null) return Json(null);
+            return Json(new {
+                product.Id, product.Name, product.Price,
+                product.Category, product.Condition, product.Includes, product.Image, product.IsAvailable
+            });
+        }
+
+        public async Task<IActionResult> MyNotifications()
+        {
+            var sellerId = User.Identity?.Name;
+
+            // Get all product IDs belonging to this seller
+            var sellerProductIds = await _context.Products
+                .Where(p => p.SellerId == sellerId)
+                .Select(p => p.ProductId)
+                .ToListAsync();
+
+            // Get all orders containing those products
+            var orders = await _context.Orders
+                .Include(o => o.Items)
+                .Where(o => o.Items.Any(i => sellerProductIds.Contains(i.ProductId)))
+                .OrderByDescending(o => o.OrderDate)
+                .ToListAsync();
+
+            return Json(orders.Select(o => new {
+                o.OrderNumber,
+                o.FirstName,
+                o.Phone,
+                o.City,
+                o.Region,
+                o.OrderDate,
+                o.OrderTotal,
+                Products = o.Items
+                    .Where(i => sellerProductIds.Contains(i.ProductId))
+                    .Select(i => i.ProductName)
+            }));
+        }
+    }
+}
