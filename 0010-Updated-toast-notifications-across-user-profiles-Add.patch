+                            <img id="listingImagePreviewImg" src="" style="max-width:100%; max-height:150px; object-fit:contain; background:#f5f5f5; border-radius:6px; border:1px solid #ddd; padding:6px;" />
+                        </div>
+                        <div id="listingImagePlaceholder" style="width:100%; height:100px; background:#f5f5f5; border-radius:6px; border:1px dashed #ccc; display:flex; align-items:center; justify-content:center; color:#aaa; font-size:0.85rem;">
+                            <i class="bi bi-image me-2"></i>Image preview
+                        </div>
+                    </div>
+                </div>
+            </div>
+            <div class="modal-footer">
+                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
+                <button type="button" class="cs-btn cs-btn-added" id="saveListingBtn" onclick="saveListing()" disabled>Save</button>
+            </div>
+        </div>
+    </div>
+</div>
+
+<!-- DELETE MODAL -->
+<div class="modal fade" id="deleteListingModal" tabindex="-1">
+    <div class="modal-dialog">
+        <div class="modal-content">
+            <div class="modal-header">
+                <h5 class="modal-title">Delete Listing</h5>
+                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
+            </div>
+            <div class="modal-body">
+                Are you sure you want to delete <strong id="deleteListingName"></strong>? This cannot be undone.
+            </div>
+            <div class="modal-footer">
+                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
+                <button type="button" class="btn btn-danger" onclick="deleteListingConfirmed()">Delete</button>
+            </div>
+        </div>
+    </div>
+</div>
+
+<!-- TOAST -->
+<div id="sellerToast" class="cs-toast" style="position:fixed; top:70px; right:1.5rem; z-index:99999;">
+    <div id="sellerToastMsg"><i id="sellerToastIcon" class="me-2"></i><span id="sellerToastText"></span></div>
+    <button class="cs-toast-close" onclick="hideToast()"><i class="bi bi-x"></i></button>
+</div>
+
+<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
+<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
+
+@section Scripts {
+    <script>
+        const PAGE_SIZE = 10;
+        var allProductRows = [], filteredProductRows = [], productPage = 1;
+        var deleteListingId = null;
+        var isEditMode = false;
+        var salesData = [];
+
+        // ===== TOAST =====
+        var toastTimer = null;
+        function showToast(message, type) {
+            var icon = document.getElementById('sellerToastIcon');
+            var text = document.getElementById('sellerToastText');
+            var toast = document.getElementById('sellerToast');
+            var closeBtn = toast.querySelector('.cs-toast-close');
+            text.textContent = message;
+            icon.className = type === 'danger' ? 'bi bi-x-circle-fill me-2' : 'bi bi-check-circle-fill me-2';
+            
+            toast.style.backgroundColor = type === 'danger' ? '#dc3545' : '';
+            closeBtn.style.backgroundColor = 'transparent';
+            closeBtn.style.color = '#fff';
+            
+            toast.classList.add('show');
+            if (toastTimer) clearTimeout(toastTimer);
+            toastTimer = setTimeout(hideToast, 4000);
+        }
+        function hideToast() { document.getElementById('sellerToast').classList.remove('show'); }
+
+        // ===== INIT =====
+        function initProducts() {
+            allProductRows = Array.from(document.querySelectorAll('#productsBody tr'));
+            filteredProductRows = allProductRows;
+            renderProducts();
+        }
+
+        // ===== FILTER =====
+        function filterProducts() {
+            var search = document.getElementById('productSearch').value.toLowerCase();
+            var condition = document.getElementById('productCondition').value.toLowerCase();
+            var availability = document.getElementById('productAvailability').value.toLowerCase();
+            filteredProductRows = allProductRows.filter(r =>
+                (!search || r.dataset.name.includes(search)) &&
+                (!condition || r.dataset.condition.toLowerCase() === condition) &&
+                (!availability || r.dataset.available.toLowerCase() === availability)
+            );
+            productPage = 1;
+            renderProducts();
+        }
+
+        function resetFilters() {
+            document.getElementById('productSearch').value = '';
+            document.getElementById('productCondition').value = '';
+            document.getElementById('productAvailability').value = '';
+            filteredProductRows = allProductRows;
+            productPage = 1;
+            renderProducts();
+        }
+
+        // ===== SORT =====
+        var sortDir = { name: 1, listed: 1 };
+        function sortProducts(col) {
+            sortDir[col] *= -1;
+            var dir = sortDir[col];
+            document.getElementById('sort-name').className = 'bi bi-arrow-down-up';
+            document.getElementById('sort-listed').className = 'bi bi-arrow-down-up';
+            document.getElementById('sort-' + col).className = dir === 1 ? 'bi bi-arrow-up' : 'bi bi-arrow-down';
+            allProductRows.sort(function(a, b) {
+                if (col === 'listed') { return (new Date(a.dataset.listed) - new Date(b.dataset.listed)) * dir; }
+                return (a.dataset.name || '').localeCompare(b.dataset.name || '') * dir;
+            });
+            var search = document.getElementById('productSearch').value.toLowerCase();
+            var condition = document.getElementById('productCondition').value.toLowerCase();
+            var availability = document.getElementById('productAvailability').value.toLowerCase();
+            filteredProductRows = allProductRows.filter(r =>
+                (!search || r.dataset.name.includes(search)) &&
+                (!condition || r.dataset.condition.toLowerCase() === condition) &&
+                (!availability || r.dataset.available.toLowerCase() === availability)
+            );
+            var tbody = document.getElementById('productsBody');
+            allProductRows.forEach(r => tbody.appendChild(r));
+            productPage = 1;
+            renderProducts();
+        }
+
+        // ===== RENDER =====
+        function renderProducts() {
+            var start = (productPage - 1) * PAGE_SIZE;
+            allProductRows.forEach(r => r.style.display = 'none');
+            filteredProductRows.slice(start, start + PAGE_SIZE).forEach(r => r.style.display = '');
+            var noResults = document.getElementById('noProductResults');
+            if (noResults) noResults.classList.toggle('d-none', filteredProductRows.length > 0);
+            renderPagination('productsPagination', filteredProductRows.length, productPage, p => { productPage = p; renderProducts(); });
+        }
+
+        function renderPagination(containerId, total, current, onPageChange) {
+            var container = document.getElementById(containerId);
+            if (!container) return;
+            var totalPages = Math.ceil(total / PAGE_SIZE);
+            container.innerHTML = '';
+            if (totalPages <= 1) return;
+            var info = document.createElement('small');
+            info.className = 'text-muted me-2';
+            info.textContent = 'Page ' + current + ' of ' + totalPages + ' (' + total + ' items)';
+            container.appendChild(info);
+            function makeBtn(label, page, disabled, active) {
+                var btn = document.createElement('button');
+                btn.className = 'btn btn-sm ' + (active ? 'btn-success' : 'btn-outline-secondary');
+                btn.textContent = label;
+                btn.disabled = disabled;
+                btn.onclick = () => onPageChange(page);
+                container.appendChild(btn);
+            }
+            makeBtn('«', 1, current === 1, false);
+            makeBtn('‹', current - 1, current === 1, false);
+            var s = Math.max(1, current - 2), e = Math.min(totalPages, s + 4);
+            for (var i = s; i <= e; i++) makeBtn(i, i, false, i === current);
+            makeBtn('›', current + 1, current === totalPages, false);
+            makeBtn('»', totalPages, current === totalPages, false);
+        }
+
+        // ===== DETAIL OVERLAY =====
+        function openProductDetail(id, name, category, price, condition, includes, image, available, listed) {
+            document.getElementById('detailImg').src = '/images/products/' + category + '/' + image;
+            document.getElementById('detailName').textContent = name;
+            document.getElementById('detailPrice').textContent = price;
+            document.getElementById('detailCategory').textContent = category;
+            document.getElementById('detailListed').textContent = listed;
+            document.getElementById('detailIncludes').textContent = includes || 'N/A';
+            var condEl = document.getElementById('detailCondition');
+            condEl.innerHTML = '<span class="cs-condition-badge cs-condition-' + condition.toLowerCase().replace(' ', '-') + '">' + condition + '</span>';
+            var availEl = document.getElementById('detailAvailable');
+            availEl.innerHTML = available === 'Available'
+                ? '<span class="badge" style="background-color:var(--cs-green);">Available</span>'
+                : '<span class="badge bg-secondary">Sold</span>';
+            document.getElementById('productDetailOverlay').style.display = 'flex';
+            document.body.style.overflow = 'hidden';
+        }
+
+        function closeProductDetail(e) { if (e.target === document.getElementById('productDetailOverlay')) closeProductDetailBtn(); }
+        function closeProductDetailBtn() { document.getElementById('productDetailOverlay').style.display = 'none'; document.body.style.overflow = ''; }
+
+        // ===== ADD MODAL =====
+        function openAddModal() {
+            isEditMode = false;
+            document.getElementById('listingModalTitle').textContent = 'Add New Listing';
+            document.getElementById('listingId').value = '';
+            document.getElementById('listingName').value = '';
+            document.getElementById('listingPrice').value = '';
+            document.getElementById('listingCategory').value = 'gaming';
+            document.getElementById('listingCondition').value = 'Like New';
+            document.getElementById('listingIncludes').value = '';
+            document.getElementById('listingImageFile').value = '';
+            document.getElementById('listingImageStatus').textContent = '';
+            document.getElementById('listingImagePreviewBox').style.display = 'none';
+            document.getElementById('listingImagePlaceholder').style.display = 'flex';
+            validateListingForm();
+            new bootstrap.Modal(document.getElementById('listingModal')).show();
+        }
+
+        // ===== EDIT MODAL =====
+        function openEditModal(id, name, category, price, condition, includes, image) {
+            isEditMode = true;
+            document.getElementById('listingModalTitle').textContent = 'Edit Listing';
+            document.getElementById('listingId').value = id;
+            document.getElementById('listingName').value = name;
+            document.getElementById('listingPrice').value = price.replace('N$', '').replace(',', '');
+            document.getElementById('listingCategory').value = category;
+            document.getElementById('listingCondition').value = condition;
+            document.getElementById('listingIncludes').value = includes;
+            document.getElementById('listingImageFile').value = '';
+            document.getElementById('listingImageStatus').textContent = image ? '✓ Current: ' + image : '';
+            if (image) {
+                document.getElementById('listingImagePreviewImg').src = '/images/products/' + category + '/' + image;
+                document.getElementById('listingImagePreviewBox').style.display = 'block';
+                document.getElementById('listingImagePlaceholder').style.display = 'none';
+            }
+            validateListingForm();
+            new bootstrap.Modal(document.getElementById('listingModal')).show();
+        }
+
+        // ===== IMAGE PREVIEW =====
+        function previewListingImage() {
+            var file = document.getElementById('listingImageFile').files[0];
+            if (!file) return;
+            var reader = new FileReader();
+            reader.onload = function(e) {
+                document.getElementById('listingImagePreviewImg').src = e.target.result;
+                document.getElementById('listingImagePreviewBox').style.display = 'block';
+                document.getElementById('listingImagePlaceholder').style.display = 'none';
+                document.getElementById('listingImageStatus').textContent = '✓ ' + file.name;
+            };
+            reader.readAsDataURL(file);
+            validateListingForm();
+        }
+
+        // ===== VALIDATE =====
+        function validateListingForm() {
+            var name = document.getElementById('listingName').value.trim();
+            var price = document.getElementById('listingPrice').value.trim();
+            var includes = document.getElementById('listingIncludes').value.trim();
+            var hasImage = isEditMode || document.getElementById('listingImageFile').files.length > 0;
+            var valid = name && price && includes && hasImage;
+            var btn = document.getElementById('saveListingBtn');
+            btn.disabled = !valid;
+            btn.classList.toggle('cs-btn-added', !valid);
+        }
+
+        // ===== SAVE =====
+        function saveListing() {
+            var id = document.getElementById('listingId').value;
+            var name = document.getElementById('listingName').value;
+            var price = document.getElementById('listingPrice').value;
+            var category = document.getElementById('listingCategory').value;
+            var condition = document.getElementById('listingCondition').value;
+            var includes = document.getElementById('listingIncludes').value;
+            var imageFile = document.getElementById('listingImageFile').files[0];
+            var formData = new FormData();
+            var url = isEditMode ? '/Seller/EditListing' : '/Seller/AddListing';
+            if (isEditMode) {
+                formData.append('id', id);
+                formData.append('name', name);
+                formData.append('price', price);
+                formData.append('condition', condition);
+                formData.append('includes', includes);
+            } else {
+                formData.append('Name', name);
+                formData.append('Price', 'N$' + price);
+                formData.append('Category', category);
+                formData.append('Condition', condition);
+                formData.append('Includes', includes);
+            }
+            if (imageFile) formData.append('imageFile', imageFile);
+            fetch(url, { method: 'POST', body: formData })
+                .then(r => r.json())
+                .then(result => {
+                    if (result.success) {
+                        bootstrap.Modal.getInstance(document.getElementById('listingModal')).hide();
+                        showToast(isEditMode ? 'Listing updated successfully!' : 'Listing added successfully!', 'success');
+                        setTimeout(() => location.reload(), 1500);
+                    }
+                });
+        }
+
+        // ===== DELETE =====
+        function confirmDelete(id, name) {
+            deleteListingId = id;
+            document.getElementById('deleteListingName').textContent = name;
+            new bootstrap.Modal(document.getElementById('deleteListingModal')).show();
+        }
+
+        function deleteListingConfirmed() {
+            fetch('/Seller/DeleteListing', {
+                method: 'POST',
+                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
+                body: 'id=' + deleteListingId
+            })
+            .then(r => r.json())
+            .then(result => {
+                if (result.success) {
+                    bootstrap.Modal.getInstance(document.getElementById('deleteListingModal')).hide();
+                    showToast('Listing deleted.', 'danger');
+                    setTimeout(() => location.reload(), 1500);
+                }
+            });
+        }
+
+        document.addEventListener('DOMContentLoaded', initProducts);
+        document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeProductDetailBtn(); });
+
+        // ===== NOTIFICATIONS =====
+        var notifLoaded = false;
+        function loadNotifications() {
+            if (notifLoaded) return;
+            fetch('/Seller/MyNotifications')
+                .then(r => r.json())
+                .then(data => {
+                    notifLoaded = true;
+                    salesData = data;
+                    document.getElementById('notifLoading').style.display = 'none';
+                    document.getElementById('notifContent').style.display = 'block';
+                    if (!data || data.length === 0) {
+                        document.getElementById('notifEmpty').style.display = 'block';
+                        return;
+                    }
+                    document.getElementById('notifTable').style.display = 'block';
+                    var badge = document.getElementById('notifBadge');
+                    badge.textContent = data.length;
+                    badge.style.display = 'inline';
+                    var tbody = document.getElementById('notifBody');
+                    tbody.innerHTML = '';
+                    data.forEach(function(n) {
+                        var date = new Date(n.orderDate).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
+                        var row = '<tr>' +
+                            '<td><small>' + n.orderNumber + '</small></td>' +
+                            '<td>' + n.firstName + '</td>' +
+                            '<td><small>' + (n.phone || 'N/A') + '</small></td>' +
+                            '<td>' + n.city + '</td>' +
+                            '<td>' + (n.region || 'N/A') + '</td>' +
+                            '<td>' + n.products.join(', ') + '</td>' +
+                            '<td style="color:var(--cs-green); font-weight:700;">N$' + Math.round(n.orderTotal).toLocaleString() + '</td>' +
+                            '<td><small>' + date + '</small></td>' +
+                            '</tr>';
+                        tbody.innerHTML += row;
+                    });
+                });
+        }
+
+        // ===== EXPORT =====
+        function downloadCSV(filename, headers, rows) {
+            var csv = [headers.join(',')].concat(rows.map(r => r.map(v => '"' + (v || '') + '"').join(','))).join('\n');
+            var a = document.createElement('a');
+            a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
+            a.download = filename;
+            a.click();
+        }
+
+        function downloadPDF(filename, title, headers, rows) {
+            var doc = new jspdf.jsPDF({ orientation: 'landscape' });
+            doc.setFontSize(14); doc.text('Ctrl + Save — ' + title, 14, 15);
+            doc.setFontSize(9); doc.text('Generated: ' + new Date().toLocaleString(), 14, 21);
+            doc.autoTable({ head: headers, body: rows, startY: 26, styles: { fontSize: 8 }, headStyles: { fillColor: [74, 124, 89] } });
+            doc.save(filename);
+        }
+
+        function exportListingsCSV() {
+            downloadCSV('my-listings.csv',
+                ['Name', 'Category', 'Price', 'Condition', 'Listed', 'Status'],
+                allProductRows.map(r => [r.dataset.fullname, r.dataset.category, r.dataset.price, r.dataset.condition, r.dataset.listed, r.dataset.available]));
+        }
+
+        function exportListingsPDF() {
+            downloadPDF('my-listings.pdf', 'My Listings',
+                [['Name', 'Category', 'Price', 'Condition', 'Listed', 'Status']],
+                allProductRows.map(r => [r.dataset.fullname, r.dataset.category, r.dataset.price, r.dataset.condition, r.dataset.listed, r.dataset.available]));
+        }
+
+        function exportSalesCSV() {
+            if (!salesData || !salesData.length) { alert('No sales data to export. Open the Sales tab first.'); return; }
+            downloadCSV('my-sales.csv',
+                ['Order #', 'Buyer', 'Phone', 'City', 'Region', 'Products Sold', 'Total', 'Date'],
+                salesData.map(n => [n.orderNumber, n.firstName, n.phone || '', n.city, n.region || '', n.products.join('; '), 'N$' + Math.round(n.orderTotal).toLocaleString(), new Date(n.orderDate).toLocaleDateString()]));
+        }
+
+        function exportSalesPDF() {
+            if (!salesData || !salesData.length) { alert('No sales data to export. Open the Sales tab first.'); return; }
+            downloadPDF('my-sales.pdf', 'My Sales',
+                [['Order #', 'Buyer', 'Phone', 'City', 'Region', 'Products', 'Total', 'Date']],
+                salesData.map(n => [n.orderNumber, n.firstName, n.phone || '', n.city, n.region || '', n.products.join(', '), 'N$' + Math.round(n.orderTotal).toLocaleString(), new Date(n.orderDate).toLocaleDateString()]));
+        }
+    </script>
+}
