new file mode 100644
index 0000000..552b259
--- /dev/null
+++ b/wwwroot/css/additions.css
@@ -0,0 +1,88 @@
+
+/* ===== SOLD BANNER ===== */
+.cs-sold-banner {
+    position: absolute;
+    top: 50%;
+    left: 50%;
+    transform: translate(-50%, -50%) rotate(-35deg);
+    background: rgba(180,0,0,0.75);
+    color: #fff;
+    font-weight: 800;
+    font-size: 1.1rem;
+    letter-spacing: 2px;
+    padding: 0.4rem 2rem;
+    white-space: nowrap;
+    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
+    pointer-events: none;
+    z-index: 2;
+}
+
+/* ===== MOBILE RESPONSIVENESS ===== */
+@media (max-width: 768px) {
+    .cs-navbar .navbar-collapse {
+        background-color: var(--cs-green);
+        padding: 0.5rem 1rem 1rem;
+        border-top: 1px solid rgba(255,255,255,0.15);
+    }
+    .navbar-nav[style*="position:absolute"] {
+        position: static !important;
+        transform: none !important;
+        flex-direction: column !important;
+        width: 100%;
+    }
+    .navbar-nav.ms-auto {
+        margin-left: 0 !important;
+        flex-direction: column;
+        width: 100%;
+    }
+    .cs-nav-link {
+        padding: 0.5rem 0 !important;
+        border-bottom: 1px solid rgba(255,255,255,0.1);
+    }
+    .cs-search-form.open .cs-search-input { width: 100%; }
+    .cs-hero { padding: 2rem 1rem; }
+    .cs-hero h1 { font-size: 1.6rem; }
+    .cs-category-icon-img { width: 60px; height: 60px; }
+    .cs-product-card img { height: 140px; }
+    .cs-detail-page { padding: 1rem 1rem 3rem; }
+    .cs-detail-title { font-size: 1.2rem; }
+    .cs-detail-price { font-size: 1.4rem; }
+    .cs-detail-meta { gap: 1rem; }
+    .cs-cart-item img { width: 60px; height: 60px; min-width: 60px; }
+    .cs-checkout-page { padding: 1rem 1rem 3rem; }
+    .cs-admin-page { padding: 1rem; }
+    .cs-stat-value { font-size: 1.4rem; }
+    .table-responsive { font-size: 0.82rem; }
+    .cs-section-header { padding: 1.25rem 1rem; }
+    .cs-section-header h2 { font-size: 1.4rem; }
+    .cs-product-grid { padding: 1rem 0.75rem 2rem; }
+    .cs-toast { right: 0.75rem; left: 0.75rem; top: 60px; }
+}
+
+/* ===== HAMBURGER → X TOGGLE ===== */
+.navbar-toggler {
+    border: none;
+    padding: 0.25rem 0.5rem;
+    outline: none !important;
+    box-shadow: none !important;
+}
+.navbar-toggler .toggler-icon {
+    display: block;
+    width: 22px;
+    height: 2px;
+    background: #fff;
+    margin: 5px 0;
+    border-radius: 2px;
+    transition: all 0.3s ease;
+    transform-origin: center;
+}
+.navbar-toggler.open .toggler-icon:nth-child(1) {
+    transform: translateY(7px) rotate(45deg);
+}
+.navbar-toggler.open .toggler-icon:nth-child(2) {
+    opacity: 0;
+    transform: scaleX(0);
+}
+.navbar-toggler.open .toggler-icon:nth-child(3) {
+    transform: translateY(-7px) rotate(-45deg);
+}
