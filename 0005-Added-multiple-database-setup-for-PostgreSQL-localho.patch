diff --git a/Data/DbContextFactory.cs b/Data/DbContextFactory.cs
index 26f5ef3..05f8293 100644
--- a/Data/DbContextFactory.cs
+++ b/Data/DbContextFactory.cs
@@ -1,6 +1,7 @@
 using Microsoft.EntityFrameworkCore;
 using Ctrl_Save.Configuration;
 using Ctrl_Save.Models;
+using Pomelo.EntityFrameworkCore.MySql.Infrastructure;
 
 namespace Ctrl_Save.Data
 {
@@ -25,6 +26,10 @@ namespace Ctrl_Save.Data
 
             switch (provider)
             {
+                case "mysql":
+                    optionsBuilder.UseMySql(connectionString, ServerVersion.Parse("26.10.0"));
+                    break;
+
                 case "postgresql":
                     optionsBuilder.UseNpgsql(connectionString);
                     break;
diff --git a/Program.cs b/Program.cs
index 716efaa..5be2999 100644
--- a/Program.cs
+++ b/Program.cs
@@ -3,6 +3,7 @@ using Microsoft.EntityFrameworkCore.Diagnostics;
 using Ctrl_Save.Models;
 using Ctrl_Save.Services;
 using Ctrl_Save.Configuration;
+using Pomelo.EntityFrameworkCore.MySql.Infrastructure;
 using Ctrl_Save.Data;
 using OpenTelemetry.Metrics;
 using OpenTelemetry.Resources;
@@ -117,6 +118,11 @@ var healthChecks = builder.Services.AddHealthChecks();
 
 switch (provider)
 {
+    case "mysql":
+        // Note: MySQL health check uses MySqlConnector, which is included with Pomelo.EntityFrameworkCore.MySql
+        // For now, we'll rely on the DbContext connection test
+        break;
+
     case "postgresql":
         healthChecks.AddNpgSql(connectionString, name: "postgresql");
         break;
@@ -141,6 +147,10 @@ builder.Services.AddDbContext<Ctrl_SaveContext>((services, options) =>
 {
     switch (provider)
     {
+        case "mysql":
+            options.UseMySql(connectionString, ServerVersion.Parse("26.10.0"));
+            break;
+
         case "postgresql":
             options.UseNpgsql(connectionString);
             break;
