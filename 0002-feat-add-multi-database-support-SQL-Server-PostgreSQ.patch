@@ -0,0 +1,45 @@
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Design;
+using Ctrl_Save.Configuration;
+using Ctrl_Save.Models;
+
+namespace Ctrl_Save.Data
+{
+    public class DesignTimeDbContextFactory : IDesignTimeDbContextFactory<Ctrl_SaveContext>
+    {
+        public Ctrl_SaveContext CreateDbContext(string[] args)
+        {
+            var optionsBuilder = new DbContextOptionsBuilder<Ctrl_SaveContext>();
+
+            var configuration = new ConfigurationBuilder()
+                .SetBasePath(Directory.GetCurrentDirectory())
+                .AddJsonFile("appsettings.json")
+                .AddJsonFile($"appsettings.{Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") ?? "Development"}.json", optional: true)
+                .Build();
+
+            var databaseSettings = configuration.GetSection("DatabaseSettings").Get<DatabaseSettings>()
+                ?? new DatabaseSettings { Provider = "SqlServer" };
+
+            string provider = databaseSettings.Provider?.ToLower() ?? "sqlserver";
+            string connectionString = databaseSettings.ConnectionString;
+
+            switch (provider)
+            {
+                case "postgresql":
+                    optionsBuilder.UseNpgsql(connectionString);
+                    break;
+
+                case "sqlite":
+                    optionsBuilder.UseSqlite(connectionString);
+                    break;
+
+                case "sqlserver":
+                default:
+                    optionsBuilder.UseSqlServer(connectionString);
+                    break;
+            }
+
+            return new Ctrl_SaveContext(optionsBuilder.Options);
+        }
+    }
+}
