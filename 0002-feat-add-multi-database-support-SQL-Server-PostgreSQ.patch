@@ -0,0 +1,45 @@
+using Microsoft.EntityFrameworkCore;
+using Ctrl_Save.Configuration;
+using Ctrl_Save.Models;
+
+namespace Ctrl_Save.Data
+{
+    public class DbContextFactory : IDbContextFactory<Ctrl_SaveContext>
+    {
+        private readonly IConfiguration _configuration;
+        private readonly DatabaseSettings _databaseSettings;
+
+        public DbContextFactory(IConfiguration configuration)
+        {
+            _configuration = configuration;
+            _databaseSettings = configuration.GetSection("DatabaseSettings").Get<DatabaseSettings>()
+                ?? new DatabaseSettings { Provider = "SqlServer" };
+        }
+
+        public Ctrl_SaveContext CreateDbContext()
+        {
+            var optionsBuilder = new DbContextOptionsBuilder<Ctrl_SaveContext>();
+            
+            string provider = _databaseSettings.Provider?.ToLower() ?? "sqlserver";
+            string connectionString = _databaseSettings.ConnectionString;
+
+            switch (provider)
+            {
+                case "postgresql":
+                    optionsBuilder.UseNpgsql(connectionString);
+                    break;
+
+                case "sqlite":
+                    optionsBuilder.UseSqlite(connectionString);
+                    break;
+
+                case "sqlserver":
+                default:
+                    optionsBuilder.UseSqlServer(connectionString);
+                    break;
+            }
+
+            return new Ctrl_SaveContext(optionsBuilder.Options);
+        }
+    }
+}
