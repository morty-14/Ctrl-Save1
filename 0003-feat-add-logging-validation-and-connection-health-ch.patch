@@ -20,6 +20,12 @@ var builder = WebApplication.CreateBuilder(args);
 var databaseSettings = builder.Configuration.GetSection("DatabaseSettings").Get<DatabaseSettings>()
     ?? new DatabaseSettings { Provider = "SqlServer" };
 
+// Validate provider and connection string
+DatabaseValidator.ValidateProvider(databaseSettings.Provider);
+DatabaseValidator.ValidateConnectionString(databaseSettings.ConnectionString, databaseSettings.Provider);
+
+Console.WriteLine($"[INFO] Database Provider: {databaseSettings.Provider}");
+
 // ===== OPENTELEMETRY =====
 var serviceName = "CtrlSave";
 var serviceVersion = "1.0.0";
@@ -132,26 +138,7 @@ builder.Services.AddAuthorization();
 // ===== SERVICES =====
 builder.Services.AddControllersWithViews();
 
-// ===== DATABASE CONTEXT FACTORY =====
-builder.Services.AddDbContextFactory<Ctrl_SaveContext>((services, options) =>
-{
-    switch (provider)
-    {
-        case "postgresql":
-            options.UseNpgsql(connectionString);
-            break;
-
-        case "sqlite":
-            options.UseSqlite(connectionString);
-            break;
-
-        case "sqlserver":
-        default:
-            options.UseSqlServer(connectionString);
-            break;
-    }
-});
-
+// ===== DATABASE CONTEXT =====
 builder.Services.AddDbContext<Ctrl_SaveContext>((services, options) =>
 {
     switch (provider)
@@ -187,8 +174,26 @@ using (var scope = app.Services.CreateScope())
 {
     var services = scope.ServiceProvider;
     var context = services.GetRequiredService<Ctrl_SaveContext>();
-    context.Database.Migrate();
-    SeedData.Initialize(services);
+    var appLogger = services.GetRequiredService<ILogger<Program>>();
+
+    try
+    {
+        // Test database connection
+        await DatabaseValidator.TestConnectionAsync(context, databaseSettings.Provider, appLogger);
+
+        // Run migrations
+        context.Database.Migrate();
+        appLogger.LogInformation("Database migrations applied successfully");
+
+        // Seed data
+        SeedData.Initialize(services);
+        appLogger.LogInformation("Database seeding completed");
+    }
+    catch (Exception ex)
+    {
+        appLogger.LogCritical($"Critical error during startup: {ex.Message}");
+        throw;
+    }
 }
 
