new file mode 100644
index 0000000..738c7c9
--- /dev/null
+++ b/Data/DatabaseValidator.cs
@@ -0,0 +1,42 @@
+using Microsoft.EntityFrameworkCore;
+using Ctrl_Save.Models;
+
+namespace Ctrl_Save.Data
+{
+    public static class DatabaseValidator
+    {
+        private static readonly string[] ValidProviders = { "SqlServer", "PostgreSQL", "SQLite" };
+
+        public static void ValidateProvider(string provider)
+        {
+            if (string.IsNullOrWhiteSpace(provider))
+                throw new InvalidOperationException("DatabaseSettings.Provider cannot be empty. Must be: SqlServer, PostgreSQL, or SQLite");
+
+            if (!ValidProviders.Contains(provider, StringComparer.OrdinalIgnoreCase))
+                throw new InvalidOperationException($"Invalid database provider: '{provider}'. Must be one of: {string.Join(", ", ValidProviders)}");
+        }
+
+        public static void ValidateConnectionString(string connectionString, string provider)
+        {
+            if (string.IsNullOrWhiteSpace(connectionString))
+                throw new InvalidOperationException($"DatabaseSettings.ConnectionString cannot be empty for provider: {provider}");
+        }
+
+        public static async Task TestConnectionAsync(Ctrl_SaveContext context, string? provider, ILogger logger)
+        {
+            try
+            {
+                var canConnect = await context.Database.CanConnectAsync();
+                if (!canConnect)
+                    throw new InvalidOperationException($"Cannot connect to {provider ?? "unknown"} database. Check connection string and server availability.");
+
+                logger.LogInformation($"✓ Database connection successful ({provider ?? "unknown"})");
+            }
+            catch (Exception ex)
+            {
+                logger.LogError($"✗ Database connection failed ({provider ?? "unknown"}): {ex.Message}");
+                throw;
+            }
+        }
+    }
+}
