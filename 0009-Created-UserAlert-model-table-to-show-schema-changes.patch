diff --git a/test-migrations.ps1 b/test-migrations.ps1
new file mode 100644
index 0000000..abc0fe8
--- /dev/null
+++ b/test-migrations.ps1
@@ -0,0 +1,19 @@
+$providers = @("SqlServer", "PostgreSQL", "SQLite")
+
+Write-Host "=== Testing Migrations ===" -ForegroundColor Cyan
+
+foreach ($provider in $providers) {
+    Write-Host "Testing $provider..." -ForegroundColor Yellow
+    
+    $config = Get-Content 'appsettings.Development.json' | ConvertFrom-Json
+    $config.DatabaseSettings.Provider = $provider
+    $config | ConvertTo-Json -Depth 10 | Set-Content 'appsettings.Development.json'
+    
+    $build = dotnet build 2>&1 | Select-String "succeeded"
+    
+    if ($build) {
+        Write-Host "  [PASS] $provider" -ForegroundColor Green
+    } else {
+        Write-Host "  [FAIL] $provider" -ForegroundColor Red
+    }
+}
